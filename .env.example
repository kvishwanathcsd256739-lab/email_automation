# Choose one email provider. Restart the dashboard after changing this file.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

PORT=3000
SEND_DELAY_MS=500
# This local cap counts Mailroom sends. Gmail can limit earlier based on other usage.
SMTP_DAILY_LIMIT=500

# Used only to initialize an account when data/auth.json does not exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional; defaults to the sender mailbox.
REPLY_TO_EMAIL=
